{
  "name": "wings-on-wheels-backend",
  "version": "1.0.0",
  "description": "Backend API for car garage portal",
  "main": "dist/main-server.js",
  "scripts": {
    "dev": "nodemon src/main-server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/database', {recursive:true}); fs.copyFileSync('src/database/schema.sql', 'dist/database/schema.sql');\"",
    "start": "node dist/main-server.js",
    "db:init": "node -r ts-node/register src/database/init.ts",
    "db:reset": "node -r ts-node/register src/database/reset.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "puppeteer": "^21.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@types/express-serve-static-core": "4.19.6"
  }
}
